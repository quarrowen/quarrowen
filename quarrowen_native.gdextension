[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

; Built into native/bin/<platform>/ by tools/build_native.sh (locally) or CI. Exports bundle the
; matching library automatically.
macos.debug = "res://native/bin/macos/libquarrowen_native.dylib"
macos.release = "res://native/bin/macos/libquarrowen_native.dylib"
linux.debug.x86_64 = "res://native/bin/linux-x86_64/libquarrowen_native.so"
linux.release.x86_64 = "res://native/bin/linux-x86_64/libquarrowen_native.so"
linux.debug.arm64 = "res://native/bin/linux-arm64/libquarrowen_native.so"
linux.release.arm64 = "res://native/bin/linux-arm64/libquarrowen_native.so"
windows.debug.x86_64 = "res://native/bin/windows-x86_64/quarrowen_native.dll"
windows.release.x86_64 = "res://native/bin/windows-x86_64/quarrowen_native.dll"

; **iOS takes a framework, not a bare dylib.** Built by `tools/build_native.sh ios` (and `ios-sim`
; for the simulator), which also links clang's iOS builtins - QuickJS needs `___chkstk_darwin` and
; Rust does not pull it in for this target. (2026-09-23)
ios.debug = "res://native/bin/ios/quarrowen_native.framework"
ios.release = "res://native/bin/ios/quarrowen_native.framework"
ios.debug.simulator = "res://native/bin/ios-sim/quarrowen_native.framework"
ios.release.simulator = "res://native/bin/ios-sim/quarrowen_native.framework"
