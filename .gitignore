.godot/
*.tmp
.DS_Store
native/target/
native/bin/
build/
addons/godot_mcp/
.mcp.json
__pycache__/
services/hub/target/

# Anything belonging to one person's own setup: server names, the children's player names, addresses.
# The .example files next to these show what to put in them.
.env
*.env
!*.env.example
*.local.md
*.local.json
deploy/*/mods/
# Logs and backups carry the same things: who played, when, and the paths of whoever ran the server.
# They live in a Docker volume in normal use, but copying a world folder in to share a repro is a very
# natural thing to do, and this is what stops that becoming a commit.
*.log
logs/
backups/
