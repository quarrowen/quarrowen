[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

; Built into native/bin/<platform>/ by tools/build_native.sh (locally) or CI. Exports bundle the
; matching library automatically.
macos.debug = "res://native/bin/macos/libvoxelcraft_native.dylib"
macos.release = "res://native/bin/macos/libvoxelcraft_native.dylib"
linux.debug.x86_64 = "res://native/bin/linux-x86_64/libvoxelcraft_native.so"
linux.release.x86_64 = "res://native/bin/linux-x86_64/libvoxelcraft_native.so"
linux.debug.arm64 = "res://native/bin/linux-arm64/libvoxelcraft_native.so"
linux.release.arm64 = "res://native/bin/linux-arm64/libvoxelcraft_native.so"
windows.debug.x86_64 = "res://native/bin/windows-x86_64/voxelcraft_native.dll"
windows.release.x86_64 = "res://native/bin/windows-x86_64/voxelcraft_native.dll"
