# Copy to .env and edit. Names are the in-game names each person types in the menu ("Playing as").
#
# !! The three worlds below are named after games that were deleted on 21 September 2026. This file is
# !! still correct for the image it pins (0.41.1 contains them), which is why it has not been changed -
# !! the family server goes on working exactly as it does today. It stops being correct the moment
# !! QW_IMAGE moves to a build without those mods: the worlds would start with nothing loaded.
# !! So rewriting this file for 1.0's games is part of cutting 1.0, not something to do before it.
# !! Bumping QW_IMAGE without rewriting the *_MODS lines is the mistake this note exists to prevent.

# --- Which version the server runs -----------------------------------------------------------------
# Pinned on purpose. A server refuses a client on a different protocol, and the Macs only update
# themselves when a release is published - so the server moving on its own would lock the children out
# with no explanation. Change these when you publish a new release for the Macs, then:
#   docker compose pull && docker compose up -d
# Use :latest instead if you would rather follow every release automatically.
QW_IMAGE=ghcr.io/quarrowen/quarrowen/server:0.41.1
QW_HUB_IMAGE=ghcr.io/quarrowen/quarrowen/hub:0.41.1

# Admins (can use /gamemode, /tp, /allow, /ugc ...). Join once as this name before sharing the server:
# the first player to use a name keeps it. The same admins run all three worlds.
ADMINS=Alex

# Only these players may join (admins always may). Add more later in game: /allow add Name
# A player allowed here is allowed on all three worlds, and travelling between them skips the check.
ALLOWLIST=Alex,Sam,Robin

# Player creations (painted skins, hats): approval = an admin approves them first (/ugc list, /ugc approve),
# auto = shown at once, off = none.
CREATIONS=approval

# Mask swear words in chat: on or off
CHAT_FILTER=on

# How many chunks of terrain each player is sent, and how many around them the world actually runs in.
# Seeing costs upload, running costs CPU, so they are separate. If the machine is struggling, lower
# SIMULATION_DISTANCE first - a shorter view is noticed long before a shorter simulation is. Blocks
# outside it sleep rather than stop: crops and furnaces catch up when somebody comes back.
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6

# Each world has its own mods folder, in a Docker volume. Add one with
#   docker cp my_mod quarrowen-hearthhold:/mods/
# then name it in that world's *_MODS below. SEED_MODS=update refreshes the bundled mods on every start;
# `missing` keeps your own edits to them, `never` leaves the folder entirely to you.
SEED_MODS=update

# --- The three worlds ------------------------------------------------------------------------------
# Shown in the game's Multiplayer list. Ports are fixed in compose.yaml: 24565, 24567, 24569.
#
# *_MODS is what each world loads. Name the game; anything it depends on comes automatically, so
# `hearthhold` loads base and vanilla with it. Every bundled mod is present in each world's mods folder,
# but only the ones named here (and their dependencies) are run. Add an add-on by listing it:
#   HEARTHHOLD_MODS=hearthhold,arcana,industry

HEARTHHOLD_NAME=Hearthhold
HEARTHHOLD_MOTD=A valley whose light went out
# Add-ons on top of the story, e.g. hearthhold,arcana,industry
HEARTHHOLD_MODS=hearthhold

ONEBLOCK_NAME=One Block
ONEBLOCK_MOTD=Break it and see what it becomes
ONEBLOCK_MODS=oneblock

SKYBLOCK_NAME=Sky Islands
SKYBLOCK_MOTD=Start on a tiny island
SKYBLOCK_MODS=skyblock

# --- The hub ---------------------------------------------------------------------------------------
# The server list the worlds announce themselves to, so they appear in the menu without anyone typing an
# address. Leave as it is for a home network. Only change it if the hub is reachable from outside.
HUB_URL=http://127.0.0.1:24600

# The address the hub should list for these worlds. Blank means "wherever the announce came from", which
# is right on a home network. Set it to this machine's LAN address if the Macs cannot connect.
PUBLIC_ADDRESS=
