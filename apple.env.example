# Apple account details for the iOS/iPad build. Copy to `apple.env`, which is gitignored.
#
# None of this is a password, but it identifies an Apple account, and this repository is public - so
# it lives here rather than in export_presets.cfg, which is committed. `tools/package_ios.sh` reads
# this file and patches the value into a throwaway copy of the preset at export time; the committed
# preset keeps an empty team id.
#
# Your Team ID is the ten characters in brackets at the end of your signing identity:
#   security find-identity -v -p codesigning
# ...gives "Developer ID Application: Your Name (ABCDE12345)" -> ABCDE12345
APPLE_TEAM_ID=
# Optional: overrides the bundle id in the preset, if you want your own.
APPLE_BUNDLE_ID=
